@import '../common/style/input.styl';

html, body {
    width: 100%;
    padding: 0;
    margin: 0;
    background: linear-gradient(180deg, #eef1f7 0%, #e6eaf2 100%);
    min-height: 100vh;
}

#option {
    padding: 0 10% 40px;
    margin: 24px auto;
    max-width: 840px;
    box-shadow: 0 12px 48px rgba(31, 41, 55, 0.12);
    background-color: #fff;
    border-radius: 16px;
    border: 1px solid rgba(255, 255, 255, 0.8);
    overflow: hidden;
}

header {
    width: 100%;
    padding: 28px 0 20px;
    font-size: 30px;
    font-weight: 800;
    color: color-primary;
    display: flex;
    align-items: center;
    border-bottom: 1px solid #eef0f4;

    img {
        width: 40px;
        height: 40px;
        margin-right: 12px;
        border-radius: 10px;
    }
}

.row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    line-height: 3em;
    margin: 1% 5%;
    padding: 6px 0;
    flex: 1 1;
    border-bottom: 1px solid #f3f4f7;
}

.column {
    display: flex;
    align-items: center;
    min-width: 30%;
    max-width: 70%;
}

.checked-label {
    cursor: pointer;
    font-size: 14px;
    color: #3c4250;
    flex: 3 3 50%;
    justify-content: space-between;
}

.radio-label {
    cursor: pointer;
    font-size: medium;
}

.setting-title {
    display: block;
    font-size: 16px;
    font-weight: 700;
    color: #1f2430;
    margin: 24px 5% 0;
    padding-left: 10px;
    border-left: 3px solid color-primary;
}

/* 组内小标题（用于在「布局设置」里切出「译文显示样式」子区） */
.setting-subtitle {
    display: block;
    font-size: 14px;
    font-weight: 600;
    color: #4a5160;
    margin: 20px 5% 0;
    padding-top: 14px;
    border-top: 1px dashed #e6e9f0;
}

select {
    height: 34px;
    padding: 0 10px;
    border: 1px solid #e2e6ef;
    border-radius: 10px;
    background-color: #f7f9fc;
    font-size: 14px;
    color: #1f2430;
    cursor: pointer;
    -webkit-appearance: none;
    -moz-appearance: none;
    appearance: none;

    &:focus {
        outline: none;
        border-color: color-primary;
        box-shadow: 0 0 0 3px rgba(74, 140, 247, 0.18);
    }
}

/* Text & password inputs (API Key / custom model name) */
input.translator-config {
    height: 36px;
    padding: 0 12px;
    border: 1px solid #e2e6ef;
    border-radius: 10px;
    background-color: #f7f9fc;
    font-size: 14px;
    color: #1f2430;
    box-sizing: border-box;
    transition: border-color 0.2s ease, box-shadow 0.2s ease, background-color 0.2s ease;

    &::placeholder {
        color: #aab2c0;
    }

    &:hover {
        border-color: #cfd6e4;
        background-color: #f1f4fa;
    }

    &:focus {
        outline: none;
        border-color: color-primary;
        background-color: #fff;
        box-shadow: 0 0 0 3px rgba(74, 140, 247, 0.18);
    }
}

.space {
    display: inline-block;
    width: 5px;
}

footer {
    padding: 24px 0;
    text-align: center;
    font-size: 13px;
    color: #9aa3b2;

    a {
        color: #9aa3b2;
        text-decoration: none;
    }

    a:hover {
        color: color-primary;
    }
}
